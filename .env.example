NODE_ENV=production
HOST=127.0.0.1
PORT=18787
PUBLIC_BASE_URL=https://your-domain.example
DATA_DIR=/www/wwwroot/juqing.073955.com/data
WORKFLOW_DIR=/www/wwwroot/juqing.073955.com/workflows
ADMIN_API_KEY=replace-with-a-long-random-secret

# redeem_only means phone number + activation code on first use.
AUTH_MODE=redeem_only

# Use development only for local testing. Use aliyun in production if SMS login is enabled.
SMS_MODE=development
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
ALIYUN_SMS_TEMPLATE_PARAM_NAME=code
